# 이 파일은 "예시"입니다. 복사해서 .env 를 만들고 실제 키를 넣으세요.
# 카카오맵 JavaScript 키 (브라우저에서 사용 → VITE_ 접두사 필요)
VITE_KAKAO_MAP_KEY=여기에_카카오_JavaScript_키
# 공공데이터포털 Decoding 키 (서버리스 함수에서만 사용 → VITE_ 붙이지 않기!)
DATA_GO_KR_KEY=여기에_공공데이터_Decoding_키

# Supabase (브라우저에서 사용 - 공개 키라 VITE_ 붙임. 보안은 DB의 RLS 규칙이 지켜요)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 문자 발송 (솔라피 SOLAPI) - 서버에서만 사용 (VITE_ 붙이지 않기!)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록·인증한 발신번호 (예: 0212345678)
SOLAPI_SENDER=
